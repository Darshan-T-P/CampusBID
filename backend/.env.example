# Copy to .env and edit. Environment variables override this file.

# --- REQUIRED outside dev mode -------------------------------------------------------------------
# Comma-separated campus email domains (subdomains match). Only these can register.
ALLOWED_EMAIL_DOMAINS=college.edu

# Signs login tokens. Must be long and random: anyone who knows it can log in as anyone.
# The app refuses to start outside dev mode if this is short or still a placeholder.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Local development / demos ---------------------------------------------------------------------
#   DEV_MODE=true     start without a domain list or strong secret; print verification codes to the log;
#                     serve the interactive API docs at /docs
#   AUTO_VERIFY=true  mark new accounts verified immediately (skip the email code step)
DEV_MODE=false
AUTO_VERIFY=false

# --- Optional --------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./campusbid.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Browser origins allowed to call the API directly (the dev proxy doesn't need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Requests bigger than this are refused with 413 (5 photos x 5 MB plus form overhead)
MAX_REQUEST_BYTES=31457280
# Password hashing cost (scrypt). Raise N if your server is fast; existing hashes upgrade at next login.
PASSWORD_SCRYPT_N=32768
PASSWORD_SCRYPT_P=3
