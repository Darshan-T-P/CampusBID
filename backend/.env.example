# Copy to .env and edit. Environment variables override this file.

# --- REQUIRED outside dev mode -------------------------------------------------------------------
# Comma-separated campus email domains (subdomains match). Only these can register.
ALLOWED_EMAIL_DOMAINS=college.edu

# Every registering email must also end with this (institutional addresses). Empty turns the check off.
REQUIRED_EMAIL_SUFFIX=.edu

# Signs login tokens. Must be long and random: anyone who knows it can log in as anyone.
# The app refuses to start outside dev mode if this is short or still a placeholder.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Local development / demos ---------------------------------------------------------------------
#   DEV_MODE=true     start without a domain list or strong secret; print verification codes to the log;
#                     serve the interactive API docs at /docs
#   AUTO_VERIFY=true  mark new accounts verified immediately (skip the email code step)
DEV_MODE=false
AUTO_VERIFY=false

# --- Email (verification codes, password reset) ----------------------------------------------------
# EMAIL_BACKEND=console  prints to the log in dev mode and sends nothing (fine for local work).
# EMAIL_BACKEND=smtp     sends real mail. Required outside dev mode unless AUTO_VERIFY=true.
# Check it works:  python scripts/send_test_email.py you@example.com
EMAIL_BACKEND=console
EMAIL_FROM=Relay <no-reply@yourdomain.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 587 uses STARTTLS (the default). For port 465 set SMTP_STARTTLS=false and SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false
# Examples
#   Gmail (needs 2-step verification + an App Password):  smtp.gmail.com : 587, username = your address
#   Brevo:     smtp-relay.brevo.com : 587, username = your login, password = an SMTP key
#   Resend:    smtp.resend.com : 465 (SMTP_SSL=true, SMTP_STARTTLS=false), username = resend, password = API key
#   Mailgun:   smtp.mailgun.org : 587, credentials from the domain's SMTP page

# --- Optional --------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./campusbid.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Browser origins allowed to call the API directly (the dev proxy doesn't need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Requests bigger than this are refused with 413 (5 photos x 5 MB plus form overhead)
MAX_REQUEST_BYTES=31457280
# Password hashing cost (scrypt). Raise N if your server is fast; existing hashes upgrade at next login.
PASSWORD_SCRYPT_N=32768
PASSWORD_SCRYPT_P=3
