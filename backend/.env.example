# Copy to .env to override defaults
DATABASE_URL=sqlite:///./campusbid.db
SECRET_KEY=change-me-to-a-long-random-string-of-32+-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# REQUIRED in production: comma-separated campus email domains (subdomains match too).
# The app refuses to start without it unless DEV_MODE=true.
ALLOWED_EMAIL_DOMAINS=college.edu

# Local development / demos only:
#   DEV_MODE=true     -> start without a domain list; verification codes are printed to the server log
#   AUTO_VERIFY=true  -> mark new accounts verified immediately (skip the email code step)
DEV_MODE=false
AUTO_VERIFY=false
